---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHome from '../components/HubHome.astro';
import { site } from '../data/site';

// Dedicated QR landing page for the printed business card ("wizytówka").
// Identical content to "/", but canonicalised to the root so Google indexes
// only the homepage (no duplicate).
//
// Counting scans: GitHub Pages serves this route at "/wizytowka/" (with a
// trailing slash — /wizytowka 301-redirects to /wizytowka/), so the auto
// page_view records the path "/wizytowka/", NOT "/wizytowka". To make the scan
// count reliable regardless of path-string matching, we also fire an explicit
// GA4 event "wizytowka_qr_scan" on load — filter by that event name in GA4 for
// a clean, unambiguous scan counter. (Same pattern as /ulotki + ulotki_qr_scan
// and /banner + banner_qr_scan, see LOCA-212 / LOCA-258 / LOCA-353.)
---

<BaseLayout path="/wizytowka" canonicalOverride={site.url}>
  <HubHome />

  {site.ga4Id && (
    <script is:inline>
      // Fire a distinct event so business-card scans are countable by event
      // name in GA4, independent of the "/wizytowka/" vs "/wizytowka" page-path
      // trailing slash.
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('event', 'wizytowka_qr_scan', {
          event_category: 'qr',
          event_label: 'wizytowka',
          page_location: window.location.href,
        });
      })();
    </script>
  )}
</BaseLayout>
